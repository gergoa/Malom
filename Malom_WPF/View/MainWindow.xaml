<Window x:Class="Malom_WPF.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Malom_WPF.View"
        mc:Ignorable="d"
        Title="Nine Men's Morris" Height="358" Width="631">
    <Window.Resources>
        <local:RemovedPiecesConverter x:Key="RemovedPiecesConverter"/>
    </Window.Resources>
    <Viewbox Margin="10,1,10,4">
        <Grid Height="330" Width="631">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="287*"/>
                <ColumnDefinition Width="181*"/>
                <ColumnDefinition Width="162*"/>
            </Grid.ColumnDefinitions>
            <Grid x:Name="NavBar" Margin="-11,-19,-11,305" Grid.ColumnSpan="3" Background="AliceBlue">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110*"/>
                    <ColumnDefinition Width="110*"/>
                    <ColumnDefinition Width="110*"/>
                    <ColumnDefinition Width="110*"/>
                    <ColumnDefinition Width="370*"/>
                </Grid.ColumnDefinitions>
                <Button Content="New Game" Command="{Binding NewGameCommand}" HorizontalAlignment="Center" VerticalAlignment="Top" Height="22" Width="70" FontFamily="Tahoma" Margin="0,19,0,0"/>
                <Button Content="Save Game" Command="{Binding SaveGameCommand}" HorizontalAlignment="Center" VerticalAlignment="Top" Height="22" Width="70" Grid.Column="1" FontFamily="Tahoma" Margin="0,19,0,0"/>
                <Button Content="Load Game" Command="{Binding LoadGameCommand}" Margin="11,19,8,0" VerticalAlignment="Top" Height="22" Width="70" Grid.Column="2" FontFamily="Tahoma"/>
                <Button Content="Quit" Command="{Binding QuitGameCommand}" HorizontalAlignment="Center" VerticalAlignment="Top" Height="22" Width="70" Grid.Column="3" FontFamily="Tahoma" Margin="0,19,0,0"/>
                <Grid.Resources>
                    <Style TargetType="{x:Type Button}">
                        <Setter Property="Background" Value="LightGray"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="VerticalAlignment" Value="Bottom"/>
                    </Style>
                </Grid.Resources>
            </Grid>
            <Viewbox Grid.Column="0" Margin="0,22,0,-22">
                <Grid x:Name="MainGrid" Height="259" Width="280">
                    <Grid.Background>
                        <ImageBrush ImageSource="background.jpg"/>
                    </Grid.Background>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Row="0" Grid.Column="0" Tag="0" Command="{Binding Buttons[0].TileClickCommand}" Foreground="{Binding Buttons[0].Occupier}" Content="◉"/>
                    <Button Grid.Row="0" Grid.Column="3" Tag="1" Command="{Binding Buttons[1].TileClickCommand}" Foreground="{Binding Buttons[1].Occupier}" Content="◉"/>
                    <Button Grid.Row="0" Grid.Column="6" Tag="2" Command="{Binding Buttons[2].TileClickCommand}" Foreground="{Binding Buttons[2].Occupier}" Content="◉"/>

                    <Button Grid.Row="1" Grid.Column="1" Tag="3" Command="{Binding Buttons[3].TileClickCommand}" Foreground="{Binding Buttons[3].Occupier}" Content="◉"/>
                    <Button Grid.Row="1" Grid.Column="3" Tag="4" Command="{Binding Buttons[4].TileClickCommand}" Foreground="{Binding Buttons[4].Occupier}" Content="◉"/>
                    <Button Grid.Row="1" Grid.Column="5" Tag="5" Command="{Binding Buttons[5].TileClickCommand}" Foreground="{Binding Buttons[5].Occupier}" Content="◉"/>

                    <Button Grid.Row="2" Grid.Column="2" Tag="6" Command="{Binding Buttons[6].TileClickCommand}" Foreground="{Binding Buttons[6].Occupier}" Content="◉"/>
                    <Button Grid.Row="2" Grid.Column="3" Tag="7" Command="{Binding Buttons[7].TileClickCommand}" Foreground="{Binding Buttons[7].Occupier}" Content="◉"/>
                    <Button Grid.Row="2" Grid.Column="4" Tag="8" Command="{Binding Buttons[8].TileClickCommand}" Foreground="{Binding Buttons[8].Occupier}" Content="◉"/>

                    <Button Grid.Row="3" Grid.Column="0" Tag="9" Command="{Binding Buttons[9].TileClickCommand}" Foreground="{Binding Buttons[9].Occupier}" Content="◉"/>
                    <Button Grid.Row="3" Grid.Column="1" Tag="10" Command="{Binding Buttons[10].TileClickCommand}" Foreground="{Binding Buttons[10].Occupier}" Content="◉"/>
                    <Button Grid.Row="3" Grid.Column="2" Tag="11" Command="{Binding Buttons[11].TileClickCommand}" Foreground="{Binding Buttons[11].Occupier}" Content="◉"/>
                    <Button Grid.Row="3" Grid.Column="4" Tag="12" Command="{Binding Buttons[12].TileClickCommand}" Foreground="{Binding Buttons[12].Occupier}" Content="◉"/>
                    <Button Grid.Row="3" Grid.Column="5" Tag="13" Command="{Binding Buttons[13].TileClickCommand}" Foreground="{Binding Buttons[13].Occupier}" Content="◉"/>
                    <Button Grid.Row="3" Grid.Column="6" Tag="14" Command="{Binding Buttons[14].TileClickCommand}" Foreground="{Binding Buttons[14].Occupier}" Content="◉"/>

                    <Button Grid.Row="4" Grid.Column="2" Tag="15" Command="{Binding Buttons[15].TileClickCommand}" Foreground="{Binding Buttons[15].Occupier}" Content="◉"/>
                    <Button Grid.Row="4" Grid.Column="3" Tag="16" Command="{Binding Buttons[16].TileClickCommand}" Foreground="{Binding Buttons[16].Occupier}" Content="◉"/>
                    <Button Grid.Row="4" Grid.Column="4" Tag="17" Command="{Binding Buttons[17].TileClickCommand}" Foreground="{Binding Buttons[17].Occupier}" Content="◉"/>

                    <Button Grid.Row="5" Grid.Column="1" Tag="18" Command="{Binding Buttons[18].TileClickCommand}" Foreground="{Binding Buttons[18].Occupier}" Content="◉"/>
                    <Button Grid.Row="5" Grid.Column="3" Tag="19" Command="{Binding Buttons[19].TileClickCommand}" Foreground="{Binding Buttons[19].Occupier}" Content="◉"/>
                    <Button Grid.Row="5" Grid.Column="5" Tag="20" Command="{Binding Buttons[20].TileClickCommand}" Foreground="{Binding Buttons[20].Occupier}" Content="◉"/>

                    <Button Grid.Row="6" Grid.Column="0" Tag="21" Command="{Binding Buttons[21].TileClickCommand}" Foreground="{Binding Buttons[21].Occupier}" Content="◉"/>
                    <Button Grid.Row="6" Grid.Column="3" Tag="22" Command="{Binding Buttons[22].TileClickCommand}" Foreground="{Binding Buttons[22].Occupier}" Content="◉"/>
                    <Button Grid.Row="6" Grid.Column="6" Tag="23" Command="{Binding Buttons[23].TileClickCommand}" Foreground="{Binding Buttons[23].Occupier}" Content="◉"/>

                    <Grid.Resources>
                        <Style TargetType="{x:Type Button}">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="FontSize" Value="22"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                        </Style>
                    </Grid.Resources>
                </Grid>

            </Viewbox>
            <Viewbox Grid.Column="1" Margin="113,51,18,51" Grid.ColumnSpan="2">
                <Grid Height="241" Width="436">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBox x:Name="RedPlayerPieces" TextWrapping="Wrap" Grid.Row="0" Text="{Binding RedRemovedPieces, Mode=OneWay, Converter={StaticResource RemovedPiecesConverter}}" Foreground="Red" FontSize="30" IsReadOnly="True" Margin="57,5,70,5" BorderBrush="IndianRed"/>
                    <TextBox x:Name="BluePlayerPieces" TextWrapping="Wrap" Grid.Row="1" Text="{Binding BlueRemovedPieces, Mode=OneWay, Converter={StaticResource RemovedPiecesConverter}}" Foreground="Blue" FontSize="30" IsReadOnly="True" Margin="57,5,70,5" BorderBrush="CornflowerBlue"/>
                    <TextBox x:Name="RoundTracker" TextWrapping="Wrap" Grid.Row="2" Text="{Binding RoundTracker, Mode=OneWay}" IsReadOnly="True" Margin="57,5,70,5" FontSize="20" FontFamily="Tahoma" BorderBrush="Transparent" Background="AliceBlue" TextAlignment="Center"/>
                </Grid>
            </Viewbox>
        </Grid>
    </Viewbox>
</Window>
